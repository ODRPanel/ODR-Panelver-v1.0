# Copy this file to .env and fill in real values before running the app.
# See the installation guide (docs/INSTALLATION_GUIDE) for step-by-step help.

# PostgreSQL connection string.
# Format: postgresql://<username>:<password>@<host>:<port>/<database name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/odr_panel"

# Random long secret used to sign login sessions. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-this-to-a-long-random-value-before-real-use"

# Local file storage folder for uploaded documents (created automatically).
STORAGE_DIR="./storage"

# Base URL the app is served from (used in notification text/links).
APP_BASE_URL="http://localhost:3000"
